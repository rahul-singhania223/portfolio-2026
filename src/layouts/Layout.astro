---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Rahul Singhania — I Build Things",
  description = "Rahul Singhania is a software developer and founder building products, systems, and AI-powered tools.",
  ogImage = "/og-image.png",

} = Astro.props;

const canonicalURL = Astro.url;
const ogImageURL = new URL(ogImage, Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
     <meta property="og:type" content="website" />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonicalURL}
    />

    <meta
      property="og:image"
      content={ogImageURL}
    />

    <meta
      property="og:image:width"
      content="1200"
    />

    <meta
      property="og:image:height"
      content="630"
    />

    <meta
      property="og:image:alt"
      content="Rahul Singhania — Software Developer and Founder"
    />

    <meta
      property="og:site_name"
      content="Rahul Singhania"
    />

    <!-- Twitter / X -->
    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="twitter:image"
      content={ogImageURL}
    />

    <meta
      name="twitter:image:alt"
      content="Rahul Singhania — Software Developer and Founder"
    />

    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="canonical"
      href={canonicalURL}
    />



  </head>

  <body class="bg-white text-neutral-950 antialiased">
    <slot />
  </body>
</html>