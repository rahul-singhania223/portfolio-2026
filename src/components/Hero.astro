---
import { Image } from "astro:assets";
---


<section
  class="relative flex min-h-screen items-center overflow-hidden px-6 pt-28 lg:px-8"
>
  <!-- Background -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="absolute left-1/2 top-1/3 h-[500px] w-[500px] -translate-x-1/2 rounded-full bg-neutral-100 blur-3xl"
    ></div>

    <div
      class="absolute inset-x-0 bottom-0 h-px bg-neutral-100"
    ></div>
  </div>

  <div class="mx-auto w-full max-w-7xl">
    <!-- Hero Content -->
    <div
      class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16"
    >
      <!-- Left Content -->
      <div class="max-w-5xl">
        <!-- Eyebrow -->
        <div class="mb-8 flex items-center gap-3">
          <span class="h-2 w-2 rounded-full bg-green-500"></span>

          <span
            class="text-sm font-medium uppercase tracking-[0.18em] text-neutral-500"
          >
            Software Developer · Founder
          </span>
        </div>

        <!-- Heading -->
        <h1
          class="max-w-5xl text-[clamp(3.5rem,8vw,8rem)] font-semibold leading-[0.92] tracking-[-0.065em]"
        >
          I build things
          <br />
          <span class="text-neutral-400">that people use.</span>
        </h1>

        <!-- Description -->
        <div class="mt-10 max-w-2xl">
          <p class="text-lg leading-8 text-neutral-500 sm:text-xl">
            I'm Rahul — a software developer and founder building products,
            business systems, and AI-powered tools from idea to production.
          </p>
        </div>

        <!-- Actions -->
        <div class="mt-10 flex flex-wrap items-center gap-4">
         <a
          href="https://wa.me/+919102977522?text=Hi%20Rahul%2C%20I%27d%20like%20to%20discuss%20a%20new%20project%20with%20you."
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-3 rounded-full bg-neutral-950 px-6 py-3.5 text-sm font-medium text-white transition-transform duration-200 hover:-translate-y-0.5"
        >
          Start A New Project With Me

          <span
            class="transition-transform duration-200 group-hover:translate-x-1"
          >
            →
          </span>
        </a>

          <a
            href="#about"
            class="inline-flex rounded-full px-6 py-3.5 text-sm font-medium text-neutral-500 transition-colors hover:text-neutral-950"
          >
            More about me
          </a>
        </div>
      </div>

      <!-- Right Image -->
      <div class="relative flex w-full justify-center lg:justify-end">
        <div
          class="relative aspect-[4/5] w-full max-w-[520px] overflow-hidden rounded-2xl -translate-y-10"
        >
          <!-- Image placeholder -->
         <Image
          src={"/rahul-avatar.png"}
          alt="Rahul Singhania"
          class="h-full w-full object-cover"
          width={1040}
          height={1350}
          format="webp"
          quality={85}
        />
        </div>
      </div>
    </div>

    <!-- Bottom metadata -->
    <div
      class="mt-24 flex flex-col justify-between gap-6 border-t border-neutral-200 pt-6 sm:flex-row sm:items-center"
    >
      <p class="text-sm text-neutral-400">
        Based in India · Working globally
      </p>

      <p class="text-sm text-neutral-400">
        Web · Mobile · AI · SaaS
      </p>
    </div>
  </div>
</section>